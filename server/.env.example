# ---- required ----
# Local dev: `npm run db:local` starts this database for you (no Docker needed)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/replydesk"
# Long random string. Also derives the key that encrypts page/LINE tokens — changing it later
# makes stored tokens unreadable (reconnect channels after a change).
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3001
NODE_ENV=development
CLIENT_URL="http://localhost:5173"
# Public https address of this server — used in webhook URLs, the widget script and local uploads
PUBLIC_URL="http://localhost:3001"

# ---- Facebook / Instagram (optional) ----
# Pages app: connects pages and SIGNS WEBHOOKS. In production the webhook refuses
# unsigned traffic, so FACEBOOK_PAGES_APP_SECRET is required once Facebook is used.
FACEBOOK_PAGES_APP_ID=""
FACEBOOK_PAGES_APP_SECRET=""
# Callback URL in the Meta app: <PUBLIC_URL>/api/webhooks/facebook (one URL for every shop) with this verify token
FACEBOOK_VERIFY_TOKEN=""
FACEBOOK_PAGES_REDIRECT_URI="http://localhost:3001/api/auth/facebook/pages/callback"
# Login app: only for "เข้าสู่ระบบด้วย Facebook" (hide the button with VITE_FACEBOOK_LOGIN=false)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3001/api/auth/facebook/callback"

# ---- LINE ----
# Nothing here: each shop pastes its Channel secret + access token in หน้า "ช่องทาง" (stored encrypted)

# ---- file uploads (optional) ----
# Without Supabase, files are stored in UPLOAD_DIR and served from PUBLIC_URL/uploads
UPLOAD_DIR="./uploads"
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

# ---- email (optional) ----
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
